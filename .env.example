# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored -- never commit real credentials.
# On a host (Hostinger hPanel, Vercel dashboard) set the same keys in its
# environment-variable settings. See ARCHITECTURE.md -> Deployment.

# ---- Required on the server -------------------------------------------------

# Public Cloudinary cloud name. Needed for every CldImage on the site.
# NEXT_PUBLIC_* values are inlined at BUILD time: set it before `npm run build`.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# SMTP for the contact form (/api/contact, via nodemailer). All four plus
# CONTACT_TO_EMAIL are required; if any is missing the form shows a friendly
# error and the server log says what's missing. Port 465 = implicit TLS,
# anything else (e.g. 587) = STARTTLS. For Gmail use an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where contact form enquiries are delivered.
CONTACT_TO_EMAIL=

# ---- Optional ---------------------------------------------------------------

# "From" address on enquiry emails. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# Sanity (the /studio CMS). Defaults are built into src/sanity/env.js, so these
# only need setting to point at a different project/dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# ---- Local only (never needed on the host) ----------------------------------

# Used only by `npm run upload:cloudinary` (scripts/upload-to-cloudinary.js)
# when uploading new project media. Keep the secret off the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
