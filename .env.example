# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored -- never commit real credentials.

# Public Cloudinary cloud name (see brain.md §4) -- required for any
# CldImage on the site to render.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# SMTP config used by src/app/api/contact/route.js to send the Contact
# page's form submissions by email via nodemailer. All five are required
# for that route to actually send mail -- if any are missing, it returns
# a clean error to the visitor and logs the real reason server-side.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where Contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Optional: the "From" address on outgoing enquiry emails. Defaults to
# SMTP_USER if not set.
CONTACT_FROM_EMAIL=
